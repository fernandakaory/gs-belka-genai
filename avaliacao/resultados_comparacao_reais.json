    "recusa": false,
    "recusa_correta": false,
    "trecho_gabarito_encontrado": true,
    "resposta": "Sim, um único valor de temperatura elevado não é suficiente para confirmar uma onda de calor. É necessário observar um período prolongado de temperaturas anormais, além de outros fatores climáticos e geográficos. Consulte a Defesa Civil local para orientações específicas.",
    "citacoes": "K15;K11;K06",
    "segundos": 0.9,
    "ferramentas": "",
    "erro": ""
  },
